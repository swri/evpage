# ==============================================================
# EvPage Environment Variables
# Salin ke .env.local lalu isi. Jangan commit .env.local.
# ==============================================================

# --- Supabase -------------------------------------------------
# Dari Project Settings > API di dashboard Supabase.
# Biarkan placeholder/kosong untuk MODE DEMO (data di localStorage browser).
# Placeholder 'your-project-id' / 'your-anon-key' dianggap "belum diisi"
# oleh src/lib/supabase/client.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Rahasia server. JANGAN pernah diberi prefiks NEXT_PUBLIC_.
# Saat ini hanya dirujuk createAdminClient() di src/lib/supabase/server.ts
# (belum dipakai halaman mana pun).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------
# Belum dibaca oleh kode; disiapkan untuk link absolut (email/notifikasi).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Opsional: Cloudflare Turnstile anti-spam -----------------
# Belum diintegrasikan; form saat ini hanya memakai honeypot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mode demo ------------------------------------------------
# Belum dibaca oleh kode. Mode demo aktif otomatis bila Supabase belum diisi.
NEXT_PUBLIC_ENABLE_DEMO_MODE=
